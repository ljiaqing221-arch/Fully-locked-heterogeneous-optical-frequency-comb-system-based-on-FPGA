{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "tests"
  ],
  "properties": {
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "top",
          "sources",
          "pass_marker"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "top": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "pass_marker": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$comment": "Runner additionally rejects whitespace-only strings and duplicate names. Paths resolve relative to the manifest."
}